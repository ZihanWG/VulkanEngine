#!/bin/bash
#
# Last gate before anything becomes public.
#
# pre-commit sees one commit at a time and only what that commit adds. This sees
# the whole range about to leave the machine, which catches the two cases the
# per-commit check cannot: a commit made before this guard existed, and one made
# with --no-verify.
#
# Reads the ref updates git feeds on stdin: <local-ref> <local-sha> <remote-ref>
# <remote-sha>. An all-zero remote sha means the branch does not exist there yet,
# so the base is the parent of the oldest commit the remote has never seen --
# and if that oldest commit is a root, there is no base and hygiene.py compares
# against the empty tree instead.
#
# Bypassable with --no-verify, and with HYGIENE_SKIP=1. Not installed at all
# until core.hooksPath is set.
set -uo pipefail

readonly HYGIENE="$(dirname "${BASH_SOURCE[0]}")/hygiene.py"
readonly ZERO='0000000000000000000000000000000000000000'
readonly REMOTE="${1:-origin}"   # git passes the remote NAME here, the URL in $2

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue          # deleting a ref

    if [ "$remote_sha" = "$ZERO" ]; then
        oldest="$(git rev-list "$local_sha" --not --remotes="$REMOTE" | tail -1)"
        [ -z "$oldest" ] && continue                # nothing the remote lacks
        base="$(git rev-parse --verify --quiet "${oldest}^" || true)"
    else
        base="$remote_sha"
    fi

    if [ -n "$base" ]; then
        "$HYGIENE" range "$local_sha" "$base" || status=1
    else
        "$HYGIENE" range "$local_sha" || status=1
    fi
done

exit "$status"
