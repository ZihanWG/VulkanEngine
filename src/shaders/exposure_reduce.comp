#version 460

// One workgroup, dispatched (1,1,1). The luminance partials are the expensive
// part -- there is one per 16x16 tile of the scene, so 14,400 of them at
// 2560x1440 -- and a single invocation walking them serially is a chain of
// dependent global reads with nothing to hide the latency behind. They are
// reduced across the threads and combined in shared memory instead.
//
// The histogram percentile walk stays serial on thread 0: it is inherently
// sequential (each bin's cumulative range depends on every bin before it) and
// it is only `binCount` iterations out of shared memory, which is cheap.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer LuminancePartials {
    vec4 partials[];
} uLuminance;

layout(std430, set = 0, binding = 1) readonly buffer LuminanceHistogram {
    uint bins[];
} uHistogram;

layout(std430, set = 0, binding = 2) buffer ExposureState {
    float exposure;
    float averageLuminance;
    float histogramLuminance;
    uint mode;
} uExposure;

layout(push_constant) uniform ExposureReducePushConstants {
    uvec4 params; // x = exposure mode, y = luminance partial count, z = histogram bin count
    vec4 exposureParams; // x = manual exposure, y = target luminance, z = min exposure, w = max exposure
    vec4 adaptationParams; // x = delta time, y = adaptation rate, z = low percentile, w = high percentile
    vec4 histogramRange; // x = min log2 luminance, y = max log2 luminance, z = min luminance
} pc;

// Must equal local_size_x above.
const uint kThreadCount = 256u;
// Must cover kHistogramBinCount (src/renderer/ExposureTypes.h, which
// static_asserts against it). A larger pushed bin count is clamped.
const uint kMaxHistogramBins = 256u;

shared float sSumLogLuminance[kThreadCount];
shared float sSampleCount[kThreadCount];
shared uint sBins[kMaxHistogramBins];

// Reads the staged bins rather than the storage buffer: thread 0 touches every
// bin twice, and shared memory makes that free relative to the global reads.
float readHistogramLuminance(float fallbackLuminance, uint binCount)
{
    uint totalSamples = 0u;
    for (uint i = 0u; i < binCount; ++i) {
        totalSamples += sBins[i];
    }
    if (totalSamples == 0u) {
        return fallbackLuminance;
    }

    float lowPercentile = clamp(pc.adaptationParams.z, 0.0, 1.0);
    float highPercentile = clamp(pc.adaptationParams.w, lowPercentile + 0.0001, 1.0);
    uint lowCut = min(totalSamples, uint(floor(float(totalSamples) * lowPercentile)));
    uint highCut = min(totalSamples, uint(ceil(float(totalSamples) * highPercentile)));
    if (highCut <= lowCut) {
        highCut = min(totalSamples, lowCut + 1u);
    }

    float minLogLuminance = pc.histogramRange.x;
    float maxLogLuminance = max(pc.histogramRange.y, minLogLuminance + 0.001);
    float binWidth = (maxLogLuminance - minLogLuminance) / float(binCount);

    uint cumulative = 0u;
    uint weightedSamples = 0u;
    float weightedLuminanceSum = 0.0;
    for (uint binIndex = 0u; binIndex < binCount; ++binIndex) {
        uint count = sBins[binIndex];
        uint binStart = cumulative;
        uint binEnd = cumulative + count;
        cumulative = binEnd;

        uint clippedStart = max(binStart, lowCut);
        uint clippedEnd = min(binEnd, highCut);
        if (clippedEnd <= clippedStart) {
            continue;
        }

        uint includedCount = clippedEnd - clippedStart;
        float logLuminance = minLogLuminance + (float(binIndex) + 0.5) * binWidth;
        float binLuminance = exp2(logLuminance);
        weightedLuminanceSum += binLuminance * float(includedCount);
        weightedSamples += includedCount;
    }

    if (weightedSamples == 0u) {
        return fallbackLuminance;
    }

    return max(weightedLuminanceSum / float(weightedSamples), pc.histogramRange.z);
}

void main()
{
    const uint localIndex = gl_LocalInvocationIndex;
    const uint mode = pc.params.x;
    const float manualExposure = max(pc.exposureParams.x, 0.0);
    const float minExposure = max(pc.exposureParams.z, 0.0);
    const float maxExposure = max(pc.exposureParams.w, minExposure);

    if (mode == 0u) {
        // `mode` comes from a push constant, so this branch is uniform across
        // the workgroup and returning before any barrier is safe.
        if (localIndex == 0u) {
            uExposure.exposure = manualExposure;
            uExposure.mode = mode;
        }
        return;
    }

    // Each thread strides through the partials, so the 14,400 dependent reads
    // become ~57 per thread across 256 threads.
    const uint partialCount = pc.params.y;
    float sumLogLuminance = 0.0;
    float sampleCount = 0.0;
    for (uint i = localIndex; i < partialCount; i += kThreadCount) {
        vec4 partial = uLuminance.partials[i];
        if (partial.y > 0.0 && !isnan(partial.x) && !isinf(partial.x) &&
            !isnan(partial.y) && !isinf(partial.y)) {
            sumLogLuminance += partial.x;
            sampleCount += partial.y;
        }
    }
    sSumLogLuminance[localIndex] = sumLogLuminance;
    sSampleCount[localIndex] = sampleCount;

    // Staged in the same pass so the bins are resident before thread 0 needs
    // them, and so this loop overlaps the partial reads above.
    const uint binCount = min(max(pc.params.z, 1u), kMaxHistogramBins);
    for (uint bin = localIndex; bin < binCount; bin += kThreadCount) {
        sBins[bin] = uHistogram.bins[bin];
    }

    barrier();

    // Threads past the partial count contributed 0.0, which is the identity for
    // both sums, so no bounds handling is needed here.
    for (uint stride = kThreadCount / 2u; stride > 0u; stride >>= 1u) {
        if (localIndex < stride) {
            sSumLogLuminance[localIndex] += sSumLogLuminance[localIndex + stride];
            sSampleCount[localIndex] += sSampleCount[localIndex + stride];
        }
        barrier();
    }

    if (localIndex != 0u) {
        return;
    }

    const float totalSampleCount = sSampleCount[0];
    float averageLuminance;
    if (totalSampleCount <= 0.0) {
        averageLuminance = max(uExposure.averageLuminance, pc.histogramRange.z);
    } else {
        averageLuminance = max(float(exp(sSumLogLuminance[0] / totalSampleCount)), pc.histogramRange.z);
    }

    float histogramLuminance = readHistogramLuminance(averageLuminance, binCount);
    float exposureLuminance = mode == 2u ? histogramLuminance : averageLuminance;
    float targetExposure =
        clamp(pc.exposureParams.y / max(exposureLuminance, pc.histogramRange.z), minExposure, maxExposure);

    float previousExposure = uExposure.exposure;
    if (isnan(previousExposure) || isinf(previousExposure) || previousExposure <= 0.0) {
        previousExposure = manualExposure;
    }

    float adaptationRate = max(pc.adaptationParams.y, 0.0);
    float adaptationAlpha = 1.0 - exp(-adaptationRate * max(pc.adaptationParams.x, 0.0));
    uExposure.exposure = clamp(mix(previousExposure, targetExposure, adaptationAlpha), minExposure, maxExposure);
    uExposure.averageLuminance = averageLuminance;
    uExposure.histogramLuminance = histogramLuminance;
    uExposure.mode = mode;
}
