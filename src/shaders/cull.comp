#version 460

layout(local_size_x = 64) in;

// std430 layout:
// - boundsMin and boundsMax are 16-byte aligned vec4 values.
// - The four scalar draw fields occupy the next 16 bytes.
// - objectFrameDataIndex is copied to firstInstance when the renderer enables
//   object-data array indexing; fallback recording keeps firstInstance at zero.
// - Runtime array stride is therefore 48 bytes, matching the C++ struct.
struct GpuCullDrawItem {
    vec4 boundsMin;
    vec4 boundsMax;
    uint indexCount;
    uint firstIndex;
    int vertexOffset;
    uint objectFrameDataIndex;
};

// Matches VkDrawIndexedIndirectCommand exactly. std430 keeps the runtime array
// stride at 20 bytes because all fields are scalar 32-bit values.
struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 0, std430) readonly buffer CullInputBuffer {
    GpuCullDrawItem drawItems[];
} cullInput;

layout(set = 0, binding = 1, std430) writeonly buffer IndirectOutputBuffer {
    DrawIndexedIndirectCommand commands[];
} indirectOutput;

layout(set = 0, binding = 2, std430) buffer VisibleCountBuffer {
    uint visibleCount;
} visibleCountOutput;

layout(push_constant) uniform CullPushConstants {
    vec4 frustumPlanes[6];
    uvec4 params; // x = draw item count, y = write objectFrameDataIndex to firstInstance, z = compact visible commands
} pc;

bool testAabb(vec3 boundsMin, vec3 boundsMax)
{
    for (uint planeIndex = 0; planeIndex < 6; ++planeIndex) {
        vec4 plane = pc.frustumPlanes[planeIndex];
        vec3 positiveVertex = vec3(
            plane.x >= 0.0 ? boundsMax.x : boundsMin.x,
            plane.y >= 0.0 ? boundsMax.y : boundsMin.y,
            plane.z >= 0.0 ? boundsMax.z : boundsMin.z);

        if (dot(plane.xyz, positiveVertex) + plane.w < 0.0) {
            return false;
        }
    }

    return true;
}

void main()
{
    uint drawIndex = gl_GlobalInvocationID.x;
    if (drawIndex >= pc.params.x) {
        return;
    }

    GpuCullDrawItem drawItem = cullInput.drawItems[drawIndex];
    bool visible = testAabb(drawItem.boundsMin.xyz, drawItem.boundsMax.xyz);
    bool compactCommands = pc.params.z != 0;

    uint outputIndex = drawIndex;
    if (compactCommands) {
        if (!visible) {
            return;
        }
        outputIndex = atomicAdd(visibleCountOutput.visibleCount, 1);
    } else if (visible) {
        atomicAdd(visibleCountOutput.visibleCount, 1);
    }

    DrawIndexedIndirectCommand command;
    command.indexCount = visible ? drawItem.indexCount : 0;
    command.instanceCount = visible ? 1 : 0;
    command.firstIndex = drawItem.firstIndex;
    command.vertexOffset = drawItem.vertexOffset;
    command.firstInstance = pc.params.y != 0 ? drawItem.objectFrameDataIndex : 0;

    indirectOutput.commands[outputIndex] = command;
}
