#version 460

#include "lod_transition.glsl"

layout(local_size_x = 64) in;

// std430 layout:
// - boundsMin and boundsMax are 16-byte aligned vec4 values.
// - The scalar draw fields occupy the next 16 bytes.
// - The batch fields plus padding occupy the final 16 bytes.
// - objectFrameDataIndex is copied to firstInstance when the renderer enables
//   object-data array indexing; fallback recording keeps firstInstance at zero.
// - batchIndex selects the per-batch visible-count entry.
// - batchOutputBase is the first command slot in that batch's compacted region.
// - lodBase/lodCount address this draw item's chain in the LOD table (binding 6);
//   they reuse what used to be two padding words, so the stride is unchanged.
// - Runtime array stride is therefore 64 bytes, matching the C++ struct.
struct GpuCullDrawItem {
    vec4 boundsMin;
    vec4 boundsMax;
    uint indexCount;
    uint firstIndex;
    int vertexOffset;
    uint objectFrameDataIndex;
    uint batchIndex;
    uint batchOutputBase;
    uint lodBase;
    uint lodCount;
};

// One level of a mesh's LOD chain: a triangle range in the shared index buffer.
// Because every level lives in that one buffer, switching level is only a change
// of the emitted (indexCount, firstIndex) -- no rebind, so it can be decided
// here, per draw item, instead of on the CPU. `error` is how far the level
// strays from the authored surface, in mesh units, never decreasing along a
// chain. std430 aligns a struct of scalars to 4, so the stride is 12 bytes,
// matching renderer::MeshLod.
struct MeshLod {
    uint firstIndex;
    uint indexCount;
    float error;
};

// Matches VkDrawIndexedIndirectCommand exactly. std430 keeps the runtime array
// stride at 20 bytes because all fields are scalar 32-bit values.
struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

// Two-phase occlusion phase results, written by phase 1 and consumed by phase 2.
const uint kPhaseFrustumCulled = 0u;
const uint kPhaseVisible = 1u;
const uint kPhaseOcclusionCandidate = 2u;

// Offset of the per-LOD counters inside the stats block; mirrors
// kGpuCullStatsLodCounterOffset in RendererInternal.h.
const uint kStatsLodCounterOffset = 5u;
// Offset of the emitted-triangle counter; mirrors
// kGpuCullStatsTriangleCounterOffset in RendererInternal.h.
const uint kStatsTriangleCounterOffset = 9u;
// Offset of the cross-fading draw item counter; mirrors
// kGpuCullStatsFadingCounterOffset in RendererInternal.h.
const uint kStatsFadingCounterOffset = 10u;

layout(set = 0, binding = 0, std430) readonly buffer CullInputBuffer {
    GpuCullDrawItem drawItems[];
} cullInput;

layout(set = 0, binding = 1, std430) writeonly buffer IndirectOutputBuffer {
    DrawIndexedIndirectCommand commands[];
} indirectOutput;

layout(set = 0, binding = 2, std430) buffer BatchVisibleCountBuffer {
    uint visibleCounts[];
} batchVisibleCounts;

layout(set = 0, binding = 3) uniform sampler2D depthPyramid;

layout(set = 0, binding = 4, std430) readonly buffer CullFrameParamsBuffer {
    mat4 occlusionViewProjection;
    mat4 occlusionViewProjectionPhase2;
    vec4 cameraPosition;
    vec4 viewportAndMipCount; // x = width, y = height, z = mip count, w = projScaleY
    vec4 occlusionSettings; // x = normal-Z depth bias, y = near disable distance, z = max coverage, w = min pixels
    vec4 lodSettings; // x = reference radius px, y = bias, z = forced level (< 0 = off), w = shadow bias
    uvec4 counterAndFlags; // x = stats counter base, y bit 0 = occlusion enabled for this frame,
                           // z = active shadow cascade count (shadow dispatch only),
                           // w = LOD transition frame serial
    uvec4 pyramidBaseSizes; // xy = pyramid written base size, zw = allocated base size
    vec4 lodErrorSettings; // x = screen-space error budget px (> 0 selects by error),
                           // y = cross-fade progress per frame (0 = off), zw unused
    // Six planes per cascade, cascade-major. Only the shadow dispatch reads them.
    vec4 shadowCascadePlanes[4 * 6];
} cullFrame;

// Phase 1 writes one result code per draw item; phase 2 dispatches over the full
// range again and re-tests only the kPhaseOcclusionCandidate entries against the
// freshly built current-frame pyramid.
layout(set = 0, binding = 5, std430) buffer PhaseResultBuffer {
    uint results[];
} phaseResults;

// Flat LOD table for every mesh referenced this frame, refilled by the renderer
// alongside the cull input. Shared by the main and shadow dispatches -- the
// levels belong to the mesh; only the selection bias differs per pass.
layout(set = 0, binding = 6, std430) readonly buffer MeshLodBuffer {
    MeshLod lods[];
} meshLods;

// One cross-fade record per draw item, persistent across frames (see
// renderer/LodTransition.h). Only the main dispatch reads or writes it.
layout(set = 0, binding = 7, std430) buffer LodTransitionStateBuffer {
    LodTransitionState states[];
} lodTransitions;

// The renderer reuses this shader for camera-frustum main culling and
// directional-light-frustum shadow culling by pushing the relevant planes.
layout(push_constant) uniform CullPushConstants {
    vec4 frustumPlanes[6];
    // x = draw item count, y = write objectFrameDataIndex, z = compact commands,
    // w bit 0 = allow occlusion, w bit 1 = occlusion phase 2 (re-test candidates),
    // w bit 2 = shadow dispatch (adds cullFrame.lodSettings.w to the LOD bias)
    uvec4 params;
} pc;

// Mirrors selectLodIndexByError() in renderer/MeshLod.h: the coarsest level
// whose error, scaled into world space and projected at the camera's distance
// to the bounds, fits the pixel budget. The budget is turned back into mesh
// units once so the loop compares stored errors directly; a camera inside the
// bounds gets a budget of 0, which only an exact level fits.
uint selectLodIndexByError(vec3 boundsMin, vec3 boundsMax, float worldScale, uint lodBase, uint lodCount, float bias)
{
    float projScaleY = cullFrame.viewportAndMipCount.w;
    if (!(worldScale > 0.0) || !(projScaleY > 0.0)) {
        return 0u;
    }
    float budgetPixels = cullFrame.lodErrorSettings.x * exp2(bias);
    if (!(budgetPixels > 0.0)) {
        return 0u;
    }

    vec3 camera = cullFrame.cameraPosition.xyz;
    float distanceToBounds = length(max(max(boundsMin - camera, camera - boundsMax), vec3(0.0)));
    float budget = budgetPixels * distanceToBounds / (projScaleY * worldScale);

    uint level = 0u;
    for (uint candidate = 1u; candidate < lodCount; ++candidate) {
        if (!(meshLods.lods[lodBase + candidate].error <= budget)) {
            break;
        }
        level = candidate;
    }
    return level;
}

// Mirrors projectedScreenRadius()/selectLodIndex() in renderer/MeshLod.h, which
// is the unit-tested reference copy, and hands off to the error rule above when
// lodErrorSettings.x selects it. Keep the two in sync -- same arrangement as
// ClusterGrid.h and cluster_build.comp.
uint selectLodIndex(vec4 boundsMin, vec4 boundsMax, uint lodBase, uint lodCount)
{
    if (lodCount <= 1u) {
        return 0u;
    }

    uint maxLod = lodCount - 1u;

    float forcedLod = cullFrame.lodSettings.z;
    if (forcedLod >= 0.0) {
        return min(uint(forcedLod), maxLod);
    }

    float bias = cullFrame.lodSettings.y;
    // Shadow dispatches drop extra detail: shadow-map resolution and PCF hide
    // simplification far better than the main pass does.
    if ((pc.params.w & 4u) != 0u) {
        bias += cullFrame.lodSettings.w;
    }

    if (cullFrame.lodErrorSettings.x > 0.0) {
        return selectLodIndexByError(boundsMin.xyz, boundsMax.xyz, boundsMin.w, lodBase, lodCount, bias);
    }

    vec3 center = (boundsMin.xyz + boundsMax.xyz) * 0.5;
    float radius = length(boundsMax.xyz - center);
    float projScaleY = cullFrame.viewportAndMipCount.w;
    if (radius <= 0.0 || projScaleY <= 0.0) {
        return 0u;
    }

    // Camera inside the bounding sphere: the object fills the view, keep level 0.
    float distanceToCamera = length(center - cullFrame.cameraPosition.xyz);
    if (distanceToCamera <= 1.0e-4) {
        return 0u;
    }

    float projectedRadiusPixels = radius / distanceToCamera * projScaleY;
    if (!(projectedRadiusPixels > 0.0)) {
        return maxLod;
    }

    // Each level covers one halving of the on-screen radius, matching the chain
    // halving triangle count per level.
    float reference = max(cullFrame.lodSettings.x, 1.0);
    float level = log2(reference / projectedRadiusPixels) + bias;
    if (!(level > 0.0)) {
        return 0u;
    }
    return min(uint(level), maxLod);
}

bool insideFrustum(vec4 planes[6], vec3 boundsMin, vec3 boundsMax)
{
    for (uint planeIndex = 0; planeIndex < 6; ++planeIndex) {
        vec4 plane = planes[planeIndex];
        vec3 positiveVertex = vec3(
            plane.x >= 0.0 ? boundsMax.x : boundsMin.x,
            plane.y >= 0.0 ? boundsMax.y : boundsMin.y,
            plane.z >= 0.0 ? boundsMax.z : boundsMin.z);

        if (dot(plane.xyz, positiveVertex) + plane.w < 0.0) {
            return false;
        }
    }

    return true;
}

// One cascade's plane set, copied out of the cascade-major array. GLSL has no
// slicing, and passing (array, base) into insideFrustum would duplicate the loop.
void loadCascadePlanes(uint cascade, out vec4 planes[6])
{
    uint base = cascade * 6u;
    for (uint planeIndex = 0; planeIndex < 6; ++planeIndex) {
        planes[planeIndex] = cullFrame.shadowCascadePlanes[base + planeIndex];
    }
}

bool testAabb(vec3 boundsMin, vec3 boundsMax)
{
    // Shadow dispatches feed every cascade from one indirect list, so an object
    // survives if ANY cascade wants it. The cascade's own projection clips the
    // ones it did not want, which makes a superset harmless -- and drawing the
    // exact per-cascade union costs strictly fewer draws than skipping the test.
    if ((pc.params.w & 4u) != 0u) {
        uint cascadeCount = max(cullFrame.counterAndFlags.z, 1u);
        vec4 planes[6];
        for (uint cascade = 0; cascade < cascadeCount; ++cascade) {
            loadCascadePlanes(cascade, planes);
            if (insideFrustum(planes, boundsMin, boundsMax)) {
                return true;
            }
        }
        return false;
    }

    return insideFrustum(pc.frustumPlanes, boundsMin, boundsMax);
}

bool validBounds(vec3 boundsMin, vec3 boundsMax)
{
    if (any(isnan(boundsMin)) || any(isnan(boundsMax)) || any(isinf(boundsMin)) || any(isinf(boundsMax))) {
        return false;
    }

    vec3 extent = boundsMax - boundsMin;
    return all(greaterThanEqual(extent, vec3(0.0001)));
}

bool testOcclusion(vec3 boundsMin, vec3 boundsMax, mat4 occlusionViewProjection)
{
    if (!validBounds(boundsMin, boundsMax)) {
        return false;
    }

    vec3 center = (boundsMin + boundsMax) * 0.5;
    float radius = length(boundsMax - center);
    if (radius <= 0.0001 || isnan(radius) || isinf(radius)) {
        return false;
    }

    float nearDisableDistance = max(cullFrame.occlusionSettings.y, 0.0);
    float distanceFromCamera = length(center - cullFrame.cameraPosition.xyz) - radius;
    if (distanceFromCamera < nearDisableDistance) {
        return false;
    }

    vec2 viewport = max(cullFrame.viewportAndMipCount.xy, vec2(1.0));
    uint mipCount = uint(max(cullFrame.viewportAndMipCount.z, 1.0));
    if (mipCount == 0u) {
        return false;
    }

    vec2 minUv = vec2(1.0);
    vec2 maxUv = vec2(0.0);
    float objectNearestDepth = 1.0;

    for (uint cornerIndex = 0; cornerIndex < 8u; ++cornerIndex) {
        vec3 corner = vec3(
            (cornerIndex & 1u) != 0u ? boundsMax.x : boundsMin.x,
            (cornerIndex & 2u) != 0u ? boundsMax.y : boundsMin.y,
            (cornerIndex & 4u) != 0u ? boundsMax.z : boundsMin.z);

        vec4 clip = occlusionViewProjection * vec4(corner, 1.0);
        if (clip.w <= 0.0001 || clip.z <= 0.0) {
            return false;
        }

        vec3 ndc = clip.xyz / clip.w;
        if (any(isnan(ndc)) || any(isinf(ndc))) {
            return false;
        }
        if (ndc.z <= 0.0 || ndc.z >= 1.0) {
            return false;
        }

        vec2 uv = ndc.xy * 0.5 + vec2(0.5);
        minUv = min(minUv, uv);
        maxUv = max(maxUv, uv);
        objectNearestDepth = min(objectNearestDepth, ndc.z);
    }

    if (minUv.x < 0.0 || minUv.y < 0.0 || maxUv.x > 1.0 || maxUv.y > 1.0) {
        return false;
    }

    vec2 rectSize = maxUv - minUv;
    vec2 pixelSize = rectSize * viewport;
    float maxDimensionPixels = max(pixelSize.x, pixelSize.y);
    if (maxDimensionPixels < max(cullFrame.occlusionSettings.w, 1.0)) {
        return false;
    }

    float coverage = rectSize.x * rectSize.y;
    if (coverage <= 0.0 || coverage > clamp(cullFrame.occlusionSettings.z, 0.01, 1.0)) {
        return false;
    }

    float mipFloat = ceil(log2(max(maxDimensionPixels, 1.0)));
    float mipLevel = clamp(mipFloat, 0.0, float(mipCount - 1u));
    vec2 inset = vec2(0.5) / max(viewport / exp2(mipLevel), vec2(1.0));
    vec2 uv0 = clamp(minUv + inset, vec2(0.0), vec2(1.0));
    vec2 uv1 = clamp(maxUv - inset, vec2(0.0), vec2(1.0));
    vec2 uvCenter = clamp((minUv + maxUv) * 0.5, vec2(0.0), vec2(1.0));

    // The pyramid is allocated at the maximum render resolution and only its
    // sub-rect is written. Each mip halves both sides independently, so the
    // written fraction drifts per level and one ratio for the whole chain would
    // be wrong everywhere but level 0. The sampler is mipmapMode NEAREST, so
    // exactly one level is read and its own ratio is the right one -- with
    // linear mip filtering this would have to blend two different scales and
    // could not be done with a single uv at all.
    //
    // A zero base (nothing sub-rected) falls out as 1:1 through the max().
    uint pyramidMip = uint(clamp(ceil(mipLevel + 0.5) - 1.0, 0.0, float(mipCount - 1u)));
    vec2 pyramidUvScale = vec2(max(cullFrame.pyramidBaseSizes.xy >> pyramidMip, uvec2(1u))) /
                          vec2(max(cullFrame.pyramidBaseSizes.zw >> pyramidMip, uvec2(1u)));
    uv0 *= pyramidUvScale;
    uv1 *= pyramidUvScale;
    uvCenter *= pyramidUvScale;

    float hizDepth = 0.0;
    hizDepth = max(hizDepth, textureLod(depthPyramid, uv0, mipLevel).r);
    hizDepth = max(hizDepth, textureLod(depthPyramid, vec2(uv1.x, uv0.y), mipLevel).r);
    hizDepth = max(hizDepth, textureLod(depthPyramid, vec2(uv0.x, uv1.y), mipLevel).r);
    hizDepth = max(hizDepth, textureLod(depthPyramid, uv1, mipLevel).r);
    hizDepth = max(hizDepth, textureLod(depthPyramid, uvCenter, mipLevel).r);

    float depthBias = max(cullFrame.occlusionSettings.x, 0.0);
    return hizDepth + depthBias < objectNearestDepth;
}

// Command slots a draw item owns in this dispatch's output. The main pass keeps
// a second one for the outgoing level of a cross-fade; the shadow dispatches
// never fade and keep one.
uint commandSlotsPerDrawItem()
{
    return (pc.params.w & 4u) != 0u ? 1u : kLodCommandSlotsPerDrawItem;
}

DrawIndexedIndirectCommand makeCommand(uint indexCount, uint firstIndex, int vertexOffset, uint firstInstance)
{
    DrawIndexedIndirectCommand command;
    command.indexCount = indexCount;
    command.instanceCount = 1;
    command.firstIndex = firstIndex;
    command.vertexOffset = vertexOffset;
    command.firstInstance = firstInstance;
    return command;
}

DrawIndexedIndirectCommand emptyCommand()
{
    return makeCommand(0u, 0u, 0, 0u);
}

// firstInstance carries the object-data slot in the low 16 bits and, in the
// high 16, what lod_transition.glsl lays out: the level this command draws and,
// mid cross-fade, which half of the fade it is and how far the fade has gone.
// What makes the high half free is that draw-item indices stay below 65536, not
// any particular cap value: kMaxDrawItems is 8192 today and a static_assert on
// the C++ side pins it at <= 0xFFFF, so raising it stays safe until it would
// cross that ceiling. Packing here is how the level, which is only known in this
// shader, reaches the vertex stage without an extra buffer, descriptor, or push
// constant. Every vertex shader that indexes object data masks with 0xFFFF.
uint packFirstInstance(uint objectFrameDataIndex, uint instanceHigh)
{
    return pc.params.y != 0 ? (objectFrameDataIndex | (instanceHigh << 16)) : 0u;
}

void emitCommand(GpuCullDrawItem drawItem, uint drawIndex, bool compactCommands)
{
    // LOD selection is a pure rewrite of the emitted index range: same vertex
    // buffer, same vertexOffset, just a different slice of the index buffer.
    // lodCount == 0 means the mesh has no chain, so fall back to the authored
    // range carried on the draw item.
    uint indexCount = drawItem.indexCount;
    uint firstIndex = drawItem.firstIndex;
    uint level = 0u;
    uint previousLevel = 0u;
    uint fade = kLodFadeSteps;
    if (drawItem.lodCount > 0u) {
        uint selected = selectLodIndex(drawItem.boundsMin, drawItem.boundsMax, drawItem.lodBase, drawItem.lodCount);
        level = selected;
        previousLevel = selected;

        // Only the main pass cross-fades, and only when the fragment shader can
        // be told it is fading: the flags ride in firstInstance, which carries
        // anything only with object-data indexing. Every emitted item advances
        // its record, fading or not, so the next frame knows where it stood.
        if ((pc.params.w & 4u) == 0u && pc.params.y != 0u) {
            LodTransitionState next;
            fade = advanceLodTransition(lodTransitions.states[drawIndex],
                                        lodTransitionIdentity(drawItem.objectFrameDataIndex, drawItem.firstIndex),
                                        selected,
                                        cullFrame.counterAndFlags.w,
                                        cullFrame.lodErrorSettings.y,
                                        next,
                                        level,
                                        previousLevel);
            lodTransitions.states[drawIndex] = next;
        }

        MeshLod lod = meshLods.lods[drawItem.lodBase + level];
        indexCount = lod.indexCount;
        firstIndex = lod.firstIndex;

        // Per-level emitted-draw histogram, read back for the debug UI. Without
        // it there is no way to tell selection apart from silently always
        // picking level 0. Counts the level being faded in, once per item.
        uint statsBase = cullFrame.counterAndFlags.x;
        atomicAdd(batchVisibleCounts.visibleCounts[statsBase + kStatsLodCounterOffset + min(level, 3u)], 1u);
    }
    bool fading = level != previousLevel;

    uint outputIndex = drawIndex * commandSlotsPerDrawItem();
    if (compactCommands) {
        // A fading item takes two consecutive commands; the batch region was
        // sized for kLodCommandSlotsPerDrawItem per item, so this cannot overflow.
        uint localVisibleIndex = atomicAdd(batchVisibleCounts.visibleCounts[drawItem.batchIndex], fading ? 2u : 1u);
        outputIndex = drawItem.batchOutputBase + localVisibleIndex;
    } else {
        atomicAdd(batchVisibleCounts.visibleCounts[0], 1);
    }

    uint instanceHigh = level;
    if (fading) {
        instanceHigh |= kLodInstanceFading | (fade << kLodInstanceFadeShift);
    }
    indirectOutput.commands[outputIndex] = makeCommand(
        indexCount, firstIndex, drawItem.vertexOffset, packFirstInstance(drawItem.objectFrameDataIndex, instanceHigh));

    // Every emitted draw, chain or not: the frame's triangle count as the cull
    // left it, which is what two LOD selection rules are compared on -- and, mid
    // fade, both levels' triangles, because both are drawn.
    uint statsBase = cullFrame.counterAndFlags.x;
    uint triangles = indexCount / 3u;

    if (fading) {
        MeshLod outgoing = meshLods.lods[drawItem.lodBase + previousLevel];
        uint outgoingHigh =
            previousLevel | kLodInstanceFading | kLodInstanceOutgoing | (fade << kLodInstanceFadeShift);
        indirectOutput.commands[outputIndex + 1u] =
            makeCommand(outgoing.indexCount,
                        outgoing.firstIndex,
                        drawItem.vertexOffset,
                        packFirstInstance(drawItem.objectFrameDataIndex, outgoingHigh));
        triangles += outgoing.indexCount / 3u;
        atomicAdd(batchVisibleCounts.visibleCounts[statsBase + kStatsFadingCounterOffset], 1u);
    } else if (!compactCommands && commandSlotsPerDrawItem() > 1u) {
        // Fixed slots are replayed whole, so the unused second one must be empty.
        indirectOutput.commands[outputIndex + 1u] = emptyCommand();
    }
    atomicAdd(batchVisibleCounts.visibleCounts[statsBase + kStatsTriangleCounterOffset], triangles);
}

// Empties every fixed slot a draw item owns, for the non-compacted paths.
void emitEmptySlots(uint drawIndex)
{
    uint slots = commandSlotsPerDrawItem();
    for (uint slot = 0u; slot < slots; ++slot) {
        indirectOutput.commands[drawIndex * slots + slot] = emptyCommand();
    }
}

void main()
{
    uint drawIndex = gl_GlobalInvocationID.x;
    if (drawIndex >= pc.params.x) {
        return;
    }

    GpuCullDrawItem drawItem = cullInput.drawItems[drawIndex];
    bool compactCommands = pc.params.z != 0;
    uint statsBase = cullFrame.counterAndFlags.x;

    // Phase 2: re-test the phase-1 occlusion candidates against the pyramid just
    // built from this frame's phase-1 depth. Anything no longer occluded is a
    // disocclusion false-negative that phase 1 missed; emit it now.
    if ((pc.params.w & 2u) != 0u) {
        bool candidate = phaseResults.results[drawIndex] == kPhaseOcclusionCandidate;
        bool rescued = candidate &&
                       !testOcclusion(drawItem.boundsMin.xyz,
                                      drawItem.boundsMax.xyz,
                                      cullFrame.occlusionViewProjectionPhase2);
        if (rescued) {
            atomicAdd(batchVisibleCounts.visibleCounts[statsBase + 4u], 1u);
            emitCommand(drawItem, drawIndex, compactCommands);
        } else if (!compactCommands) {
            // Non-compacted phase 2 owns every fixed command slot: zero the
            // non-rescued ones so the replayed multi-draw skips items phase 1
            // already drew or culled.
            emitEmptySlots(drawIndex);
        }
        return;
    }

    bool frustumVisible = testAabb(drawItem.boundsMin.xyz, drawItem.boundsMax.xyz);
    bool occlusionEnabled = (pc.params.w & 1u) != 0u && (cullFrame.counterAndFlags.y & 1u) != 0u;
    bool occluded = frustumVisible && occlusionEnabled &&
                    testOcclusion(drawItem.boundsMin.xyz, drawItem.boundsMax.xyz, cullFrame.occlusionViewProjection);
    bool visible = frustumVisible && !occluded;

    phaseResults.results[drawIndex] =
        visible ? kPhaseVisible : (occluded ? kPhaseOcclusionCandidate : kPhaseFrustumCulled);

    atomicAdd(batchVisibleCounts.visibleCounts[statsBase + 0u], 1u);
    if (visible) {
        atomicAdd(batchVisibleCounts.visibleCounts[statsBase + 1u], 1u);
    } else if (!frustumVisible) {
        atomicAdd(batchVisibleCounts.visibleCounts[statsBase + 2u], 1u);
    } else if (occluded) {
        atomicAdd(batchVisibleCounts.visibleCounts[statsBase + 3u], 1u);
    }

    if (visible) {
        emitCommand(drawItem, drawIndex, compactCommands);
    } else if (compactCommands) {
        return;
    } else {
        // Non-compacted paths keep fixed command slots per draw item; zero them
        // so the fixed-slot indirect draw skips this item.
        emitEmptySlots(drawIndex);
    }
}
