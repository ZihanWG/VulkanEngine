#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_nonuniform_qualifier : require

// The ray-traced shadow mask: the sun's visibility for every pixel the depth
// prepass covered, traced once here instead of once per shaded fragment in the
// main pass. Runs between DepthPrepass and MainHDRPass; see
// docs/ray_traced_shadows.md and renderer/RayTracedShadowMask.h.
//
// Each texel is (visibility bits, depth bits). The depth is the prepass's own,
// copied exactly, and it is how the main pass decides whether the texel is about
// the fragment it is shading: only the surface the prepass drew has exactly this
// depth under its LESS_OR_EQUAL test. Everything the prepass does not draw -- the
// skinned mesh, phase-two rescues, blended surfaces -- is strictly in front of
// it and traces inline instead.

#include "ray_traced_shadows.glsl"

layout(local_size_x = kRtMaskLocalSize, local_size_y = kRtMaskLocalSize, local_size_z = 1) in;

// Main depth as the prepass left it, through a nearest sampler.
layout(set = 0, binding = 0) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 1) uniform accelerationStructureEXT uSceneTopLevel;
layout(set = 0, binding = 2, rg32ui) uniform writeonly uimage2D uRayTracedShadowMask;
// The bindless base colour heap, at the set the main pass also binds it at, for
// the cutout test.
layout(set = 1, binding = 0) uniform sampler2D uBaseColorTextures[];

#include "ray_traced_shadow_trace.glsl"

// Mirrors ve::renderer::RayTracedShadowMaskPushConstants.
layout(push_constant) uniform MaskPushConstants {
    FrameConstantsBuffer frameConstants;
    ObjectFrameDataBuffer objectFrameData;
    // The render-resolution sub-rect the prepass drew, and its reciprocal.
    uvec2 extent;
    vec2 inverseExtent;
    // Inverse of the jittered view-projection the prepass rasterised with, so a
    // pixel centre reconstructs to the same surface point the main pass shades
    // there.
    mat4 inverseViewProjection;
} pc;

vec3 worldPositionAt(ivec2 pixel, float depth)
{
    vec2 ndc = (vec2(pixel) + 0.5) * pc.inverseExtent * 2.0 - 1.0;
    vec4 world = pc.inverseViewProjection * vec4(ndc, depth, 1.0);
    return world.xyz / world.w;
}

// Depth at a neighbour, or 2.0 -- further than any surface -- when it is outside
// the sub-rect or on the cleared far plane, so it is never the closer choice.
float neighbourDepth(ivec2 pixel)
{
    if (any(lessThan(pixel, ivec2(0))) || any(greaterThanEqual(pixel, ivec2(pc.extent)))) {
        return 2.0;
    }
    float depth = texelFetch(uSceneDepth, pixel, 0).r;
    return depth >= 1.0 ? 2.0 : depth;
}

// One axis of the reconstructed surface: towards whichever neighbour is closer
// in depth, so a silhouette takes its tangent from the surface it belongs to and
// not across the gap to whatever lies behind. False when neither side is usable.
bool surfaceTangent(ivec2 pixel, ivec2 step, float depth, vec3 position, out vec3 tangent)
{
    float after = neighbourDepth(pixel + step);
    float before = neighbourDepth(pixel - step);
    if (after > 1.0 && before > 1.0) {
        return false;
    }
    if (abs(after - depth) <= abs(before - depth)) {
        tangent = worldPositionAt(pixel + step, after) - position;
    } else {
        tangent = position - worldPositionAt(pixel - step, before);
    }
    return true;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, pc.extent))) {
        return;
    }

    float depth = texelFetch(uSceneDepth, pixel, 0).r;
    // Every texel is rewritten, including the ones nothing covered: the image
    // persists across frames, and a stale depth that happened to match a
    // fragment this frame would hand it another frame's answer.
    float visibility = kRtMaskNotTraced;
    if (depth < 1.0) {
        vec3 position = worldPositionAt(pixel, depth);
        vec3 tangentX;
        vec3 tangentY;
        if (surfaceTangent(pixel, ivec2(1, 0), depth, position, tangentX) &&
            surfaceTangent(pixel, ivec2(0, 1), depth, position, tangentY)) {
            vec3 normal = normalize(cross(tangentX, tangentY));
            if (dot(normal, pc.frameConstants.values.cameraPosition.xyz - position) < 0.0) {
                normal = -normal;
            }
            vec3 towardLight = normalize(-pc.frameConstants.values.lightDirection.xyz);
            // Traced whichever way the surface faces, with the offset turned
            // towards the sun inside rayTracedSunVisibility, exactly as the
            // inline ray does. A surface facing away from the sun is not
            // necessarily dark in the main pass: a normal map can tilt its
            // shading normal past the sun's horizon, and on Sponza leaving such
            // pixels untraced sent a third of every lit fragment to the inline
            // fallback. Where the main pass does not need the term the ray is
            // wasted, but it is cheap: it starts behind its own surface and the
            // first triangle it tests is usually that surface.
            //
            // Marked when the surface faces away, because one case of it is not
            // this ray's to answer: the terminator of a smooth-shaded surface,
            // where the fragment's vertex normal still faces the sun. See
            // rayTracedShadowFromMask.
            visibility = rayTracedSunVisibility(pc.frameConstants, pc.objectFrameData, position, normal, towardLight);
            if (dot(normal, towardLight) < 0.0) {
                visibility += kRtMaskBackFacingBias;
            }
        }
    }
    imageStore(uRayTracedShadowMask, pixel, uvec4(floatBitsToUint(visibility), floatBitsToUint(depth), 0u, 0u));
}
