#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uSceneColor;
layout(std430, set = 0, binding = 1) buffer LuminanceHistogram {
    uint bins[];
} uHistogram;

layout(push_constant) uniform HistogramPushConstants {
    uvec4 params; // x = width, y = height, z = bin count
    vec4 logLuminanceRange; // x = min log2 luminance, y = max log2 luminance, z = epsilon
} pc;

// Each group tallies into workgroup-shared bins first, so the pass costs one
// global atomic per non-empty bin per group instead of one per pixel. A 16x16
// tile of a real image lands in a handful of bins, so most groups skip most of
// the flush entirely.
//
// The capacity must cover kHistogramBinCount (src/renderer/ExposureTypes.h,
// which static_asserts against this value). A larger bin count is clamped
// rather than allowed to run off the end of the shared array.
const uint kSharedBinCapacity = 256u;
shared uint sBins[kSharedBinCapacity];

void main()
{
    const uint binCount = clamp(pc.params.z, 1u, kSharedBinCapacity);
    const uint threadCount = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
    const uint localIndex = gl_LocalInvocationIndex;

    for (uint bin = localIndex; bin < binCount; bin += threadCount) {
        sBins[bin] = 0u;
    }

    barrier();

    // Out-of-range invocations skip the tally but must still reach both
    // barriers, so this is an `if` and not an early return.
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const uvec2 extent = pc.params.xy;
    if (pixel.x < extent.x && pixel.y < extent.y) {
        vec3 color = texelFetch(uSceneColor, ivec2(pixel), 0).rgb;
        float luminance = dot(max(color, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
        float logLuminance = log2(max(luminance, max(pc.logLuminanceRange.z, 0.000001)));

        float minLogLuminance = pc.logLuminanceRange.x;
        float maxLogLuminance = max(pc.logLuminanceRange.y, minLogLuminance + 0.001);
        float normalized = clamp((logLuminance - minLogLuminance) / (maxLogLuminance - minLogLuminance), 0.0, 0.999999);

        uint binIndex = min(uint(normalized * float(binCount)), binCount - 1u);
        atomicAdd(sBins[binIndex], 1u);
    }

    barrier();

    for (uint bin = localIndex; bin < binCount; bin += threadCount) {
        uint count = sBins[bin];
        if (count != 0u) {
            atomicAdd(uHistogram.bins[bin], count);
        }
    }
}
