#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sourceDepth;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D outputMip;

layout(push_constant) uniform DepthPyramidPushConstants {
    uvec4 sizes; // xy = source size, zw = destination mip size
} pc;

// The renderer uses normal-Z depth: 0 is near and 1 is far. Each pyramid level
// stores the maximum depth in its source footprint, so an object is culled only
// when every covered source texel is closer than the object's nearest depth.
void main()
{
    uvec2 dst = gl_GlobalInvocationID.xy;
    if (dst.x >= pc.sizes.z || dst.y >= pc.sizes.w) {
        return;
    }

    uvec2 srcMin = (dst * pc.sizes.xy) / pc.sizes.zw;
    uvec2 srcMax = ((dst + uvec2(1u)) * pc.sizes.xy + pc.sizes.zw - uvec2(1u)) / pc.sizes.zw;
    srcMax = clamp(srcMax, srcMin + uvec2(1u), pc.sizes.xy);

    float maxDepth = 0.0;
    for (uint y = srcMin.y; y < srcMax.y; ++y) {
        for (uint x = srcMin.x; x < srcMax.x; ++x) {
            maxDepth = max(maxDepth, texelFetch(sourceDepth, ivec2(x, y), 0).r);
        }
    }

    imageStore(outputMip, ivec2(dst), vec4(maxDepth, 0.0, 0.0, 1.0));
}
