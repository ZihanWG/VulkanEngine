# Generated shader binaries are produced by CMake under the build tree.
**/shaders/*.spv

# User-local runtime renderer settings are generated from the ImGui debug UI.
config/runtime_settings.json
# Per-user ImGui window layout, written beside the runtime settings for the same
# reason: it is local state, not something the repository should carry.
config/imgui_layout.ini

# F12 writes a timestamped capture plus an overwritten `_latest` copy. Only the
# latest one is referenced (docs/portfolio_capture.md), and these are 3-15 MB
# each, so the timestamped ones stay local.
/screenshots/vulkan_engine_portfolio_[0-9]*.png
